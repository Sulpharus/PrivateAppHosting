{
  "name": "mininode",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:start": "supabase start -x studio,imgproxy,vector,logflare,edge-runtime,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --level warning",
    "test:integration": "scripts/with-local-supabase.sh turbo run test",
    "mininode": "node packages/cli/src/bin.ts",
    "e2e": "scripts/with-local-supabase.sh playwright test -c e2e/playwright.config.ts",
    "spec:short": "node scripts/generate-short-spec.ts",
    "kb": "scripts/kb.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@mininode/config": "workspace:*",
    "@mininode/gate": "workspace:*",
    "@playwright/test": "1.63.0",
    "@supabase/supabase-js": "2.117.1",
    "@types/node": "^22.20.4",
    "supabase": "2.117.0",
    "turbo": "2.11.3",
    "typescript": "7.0.2",
    "wrangler": "4.137.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase",
      "esbuild",
      "workerd",
      "sharp"
    ]
  }
}
