{
  "$schema": "../../packages/manifest/schema.json",
  "specVersion": 1,
  "slug": "codeknacker",
  "name": "Codeknacker",
  "description": "Den geheimen Code aus vier von sechs Zeichen in zehn Versuchen knacken, mit Bestenliste für Versuche und Zeit",
  "kind": "static",
  "target": "cloudflare",
  "access": {
    "default": true
  },
  "data": {
    "mode": "none"
  },
  "game": {
    "genre": "puzzle",
    "players": "solo",
    "stats": [
      {
        "id": "guesses",
        "label": "Versuche",
        "better": "lower",
        "min": 1,
        "max": 10
      },
      {
        "id": "time",
        "label": "Zeit",
        "better": "lower",
        "format": "seconds",
        "min": 1,
        "max": 7200
      }
    ]
  },
  "i18n": {
    "languages": ["de", "en"],
    "default": "de"
  }
}
