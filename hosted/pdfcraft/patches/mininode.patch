+/// UTC seconds since the epoch, from the browser.
+#[cfg(target_arch = "wasm32")]
+fn wall_clock() -> i64 {
+    (js_sys::Date::now() / 1000.0).floor() as i64
+}
+
+/// The browser's local zone in seconds east of UTC, now (`getTimezoneOffset` is minutes west).
+#[cfg(target_arch = "wasm32")]
+fn utc_offset() -> i64 {
+    -(js_sys::Date::new_0().get_timezone_offset() as i64) * 60
+}
+
+/// The person's display name that MiniNode puts on `<html data-mn-user>`, when it has one.
+#[cfg(target_arch = "wasm32")]
+fn mininode_user() -> Option<String> {
+    let root = web_sys::window()?.document()?.document_element()?;
+    root.get_attribute("data-mn-user").map(|a| a.trim().to_string()).filter(|a| !a.is_empty())
+}
