+/// MiniNode: how the browser build writes its settings to `localStorage` (`PdfCraftApp::save`).
+#[cfg(target_arch = "wasm32")]
+#[derive(Default)]
+struct WebStore {
+    /// A frame ran since the last check, so the settings may have changed.
+    frames_since_save: bool,
+    /// The settings JSON last written (at first, what `localStorage` holds).
+    written: Option<String>,
+    /// When `egui_memory_ron` was last written (`Date.now()`), and whether the page was hidden at the last check.
+    memory_saved_at: std::cell::Cell<f64>,
+    hidden: std::cell::Cell<bool>,
+}
+
+/// MiniNode: the encoded images (custom stamps up to 4 MB each, image signatures, initials and
+/// signing graphics) kept in the web's settings. `localStorage` holds about 5 MB per site and is
+/// synced to the person's account on every write, so images are kept, in this order, only while
+/// they fit; the rest last until the page is closed.
+#[cfg(target_arch = "wasm32")]
+const WEB_IMAGE_BUDGET: usize = 512 << 10;
+
+#[cfg(target_arch = "wasm32")]
+fn web_image_budget(v: &mut serde_json::Value) {
+    let mut left = WEB_IMAGE_BUDGET;
+    let mut fits = |value: &serde_json::Value| {
+        let len = value.to_string().len();
+        let fit = len <= left;
+        if fit {
+            left -= len;
+        }
+        fit
+    };
+    // Typed and drawn signatures and the Name graphic are small strings and points; only images count.
+    for key in ["signature_image", "initials", "sign_graphic"] {
+        let image = v[key].as_object().is_some_and(|o| o.contains_key("Image"));
+        if image && !fits(&v[key]) {
+            v[key] = serde_json::Value::Null;
+        }
+    }
+    if let Some(stamps) = v["custom_stamps"].as_array_mut() {
+        stamps.retain(|s| fits(s));
+    }
+}
+
