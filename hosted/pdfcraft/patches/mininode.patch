     fn save(&mut self, storage: &mut dyn eframe::Storage) {
+        // MiniNode: in the browser `localStorage` is synced to the person's account on every write,
+        // so only settings that changed are written, checked about once a second after a frame ran
+        // (and when the page is hidden or closed, where eframe saves too).
+        #[cfg(target_arch = "wasm32")]
+        {
+            if !std::mem::take(&mut self.web_store.frames_since_save) {
+                return;
+            }
+            let json = self.persist();
+            let written = self.web_store.written.get_or_insert_with(|| storage.get_string("pdfcraft").unwrap_or_default());
+            if *written != json {
+                storage.set_string("pdfcraft", json.clone());
+                *written = json;
+            }
+        }
+        #[cfg(not(target_arch = "wasm32"))]
         storage.set_string("pdfcraft", self.persist());
     }
 
