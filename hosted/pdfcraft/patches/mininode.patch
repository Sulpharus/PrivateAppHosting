+    fn persist_egui_memory(&self) -> bool {
+        let now = js_sys::Date::now();
+        if self.web_store.memory_saved_at.get() == 0.0 {
+            // The first check starts the 30 seconds, as eframe's first save would.
+            self.web_store.memory_saved_at.set(now);
+        }
+        let hidden = web_sys::window().and_then(|w| w.document()).is_some_and(|d| d.hidden());
+        let due = now - self.web_store.memory_saved_at.get() >= 30_000.0 || (hidden && !self.web_store.hidden.get());
+        self.web_store.hidden.set(hidden);
+        if due {
+            self.web_store.memory_saved_at.set(now);
+        }
+        due
+    }
