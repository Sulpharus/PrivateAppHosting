+/// MiniNode: the `localStorage` key holding the preferences. MiniNode syncs `localStorage` to the
+/// person's account, so the settings follow them to their other devices.
+const PREFS_KEY: &str = "wordcraft.preferences";
+/// Seconds between looks at whether the preferences changed.
+const PREFS_CHECK_SECS: f64 = 1.0;
+
+/// MiniNode: the preferences the desktop app keeps in `ui.json` ([`WordApp::prefs`], the same
+/// JSON), kept in `localStorage` under [`PREFS_KEY`]. Written only when the JSON changed: at most
+/// once per [`PREFS_CHECK_SECS`], and when the page is hidden.
+struct Prefs {
+    /// The person's MiniNode name (`data-mn-user`): the author while they haven't set one.
+    mn_user: Option<String>,
+    /// The JSON last read or written.
+    saved: RefCell<String>,
+    next_check: Cell<f64>,
+}
+
+impl Prefs {
+    /// Apply the saved preferences, then the web's defaults where nothing was saved: the interface
+    /// follows the system's light or dark appearance, and the author is the MiniNode name.
+    fn load(app: &mut WordApp) -> Prefs {
+        app.ui.theme = wordcraft_ui_egui::theme::Appearance::System;
+        let default_author = app.session.author.clone();
+        if let Some(ui) = local_storage().and_then(|s| s.get_item(PREFS_KEY).ok().flatten()).and_then(|json| UiState::from_json(json.as_bytes())) {
+            app.apply_prefs(ui);
+        }
+        let mn_user = web_sys::window()
+            .and_then(|w| w.document())
+            .and_then(|d| d.document_element())
+            .and_then(|e| e.get_attribute("data-mn-user"))
+            .map(|n| n.trim().to_string())
+            .filter(|n| !n.is_empty());
+        if let Some(name) = &mn_user
+            && (app.session.author.trim().is_empty() || app.session.author == default_author)
+        {
+            app.session.author = name.clone();
+        }
+        let prefs = Prefs { mn_user, saved: RefCell::new(String::new()), next_check: Cell::new(0.0) };
+        if let Some(json) = prefs.json(app) {
+            prefs.saved.replace(json);
+        }
+        prefs
+    }
+
+    fn json(&self, app: &WordApp) -> Option<String> {
+        let mut ui = app.prefs();
+        // Not restored at start-up (`apply_prefs`), so not worth a write on every tab switch.
+        ui.tab = wordcraft_ui_egui::DEFAULT_TAB.into();
+        ui.backstage = false;
+        ui.backstage_page = "home".into();
+        // The MiniNode name stays a default, so a new name there still shows.
+        if self.mn_user.as_deref() == Some(ui.author.as_str()) {
+            ui.author.clear();
+        }
+        serde_json::to_string(&ui).ok()
+    }
+
+    fn save(&self, app: &WordApp) {
+        let Some(json) = self.json(app) else { return };
+        if *self.saved.borrow() == json {
+            return;
+        }
+        match local_storage().map(|s| s.set_item(PREFS_KEY, &json)) {
+            Some(Ok(())) => {
+                self.saved.replace(json);
+            }
+            Some(Err(e)) => log::warn!("preferences not saved: {e:?}"),
+            None => log::warn!("preferences not saved: no localStorage"),
+        }
+    }
+
+    fn tick(&self, app: &WordApp, now: f64) {
+        if now >= self.next_check.get() {
+            self.next_check.set(now + PREFS_CHECK_SECS);
+            self.save(app);
+        }
+    }
+}
+
+fn local_storage() -> Option<web_sys::Storage> {
+    web_sys::window()?.local_storage().ok().flatten()
+}
+
+/// MiniNode: save the preferences when the page is hidden or left, which the next frame may not
+/// live to see. Events run between frames, so the app is free to borrow then.
+fn save_prefs_when_hidden(app: Rc<RefCell<WordApp>>, prefs: Rc<Prefs>) -> Result<(), String> {
+    let window = web_sys::window().ok_or("no window")?;
+    let document = window.document().ok_or("no document")?;
+    let doc = document.clone();
+    let on_hide = wasm_bindgen::closure::Closure::<dyn FnMut(web_sys::Event)>::new(move |e: web_sys::Event| {
+        if (e.type_() == "pagehide" || doc.hidden())
+            && let Ok(app) = app.try_borrow()
+        {
+            prefs.save(&app);
+        }
+    });
+    document.add_event_listener_with_callback("visibilitychange", on_hide.as_ref().unchecked_ref()).map_err(|e| format!("{e:?}"))?;
+    window.add_event_listener_with_callback("pagehide", on_hide.as_ref().unchecked_ref()).map_err(|e| format!("{e:?}"))?;
+    // The listener lives as long as the page.
+    on_hide.forget();
+    Ok(())
+}
