+/// MiniNode: `document.documentElement.lang`, when the page sets one.
+#[cfg(target_arch = "wasm32")]
+fn page_lang() -> Option<String> {
+    use js_sys::wasm_bindgen::JsValue;
+    let get = |obj: &JsValue, key: &str| js_sys::Reflect::get(obj, &JsValue::from_str(key)).ok().filter(|v| !v.is_undefined() && !v.is_null());
+    let document = get(&js_sys::global(), "document")?;
+    let root = get(&document, "documentElement")?;
+    get(&root, "lang")?.as_string().map(|s| s.trim().to_string()).filter(|s| !s.is_empty())
+}
