diff --git a/apps/lightcraft-web/src/account.rs b/apps/lightcraft-web/src/account.rs
new file mode 100644
index 0000000..661627e
--- /dev/null
+++ b/apps/lightcraft-web/src/account.rs
@@ -0,0 +1,155 @@
+//! MiniNode: settings that follow the account. MiniNode syncs `localStorage` to the signed-in
+//! person's account, so the library's settings files (UI state, library preferences, develop
+//! presets) are also kept there, under [`KEY`], as one JSON object of file name → file text. At
+//! start-up a stored file replaces the copy in browser storage (OPFS/IndexedDB), which stays the
+//! fallback for existing libraries and the copy backups are made from. The catalog, view state,
+//! originals and thumbnails stay on the device.
+
+use std::cell::{Cell, RefCell};
+use std::rc::Rc;
+
+use wasm_bindgen::JsCast;
+use wasm_bindgen::prelude::*;
+
+use crate::files::Files;
+
+/// The `localStorage` key.
+pub const KEY: &str = "lightcraft.preferences";
+
+/// The library files that are settings, not data.
+const FILES: [&str; 3] = ["ui.json", "prefs.json", "presets.json"];
+
+/// At most this much goes to `localStorage`: a large preset collection (presets.json can reach
+/// tens of MB) stays on the device instead, and is never replaced by the account's copy.
+const MAX_BYTES: usize = 512 * 1024;
+
+fn storage() -> Option<web_sys::Storage> {
+    web_sys::window()?.local_storage().ok().flatten()
+}
+
+/// True the first time it is asked on this account (the marker is synced like the settings).
+pub fn first_theme_reset() -> bool {
+    const MARK: &str = "lightcraft.theme-reset";
+    let Some(s) = storage() else { return false };
+    if s.get_item(MARK).ok().flatten().is_some() {
+        return false;
+    }
+    let _ = s.set_item(MARK, "1");
+    true
+}
+
+/// The page's language as MiniNode set it (`<html lang>`), if LightCraft has it.
+pub fn page_language() -> Option<lightcraft_ui_egui::i18n::Locale> {
+    let lang = web_sys::window()?.document()?.document_element()?.get_attribute("lang")?;
+    lightcraft_ui_egui::i18n::Locale::parse_tag(lang.trim())
+}
+
+/// Put the account's settings files into `files` (dirty where they differ, so browser storage
+/// follows). Returns the stored text, to compare later saves against.
+pub fn load(files: &Files) -> String {
+    let Some(text) = storage().and_then(|s| s.get_item(KEY).ok().flatten()) else { return String::new() };
+    let Ok(serde_json::Value::Object(map)) = serde_json::from_str::<serde_json::Value>(&text) else {
+        log::warn!("lightcraft: ignoring unreadable {KEY}");
+        return String::new();
+    };
+    for name in FILES {
+        let Some(data) = map.get(name).and_then(|v| v.as_str()) else { continue };
+        if files.len_of(name).is_some_and(|n| n > MAX_BYTES) {
+            continue;
+        }
+        if files.get(name).as_deref() != Some(data.as_bytes()) {
+            files.write(name, data.as_bytes());
+        }
+    }
+    text
+}
+
+/// Saves the settings files to `localStorage` when they change.
+#[derive(Clone)]
+pub struct Sync {
+    files: Files,
+    /// The text last stored under [`KEY`].
+    written: Rc<RefCell<String>>,
+    /// The files' revisions that text was built from (`None` before the first save).
+    seen: Rc<Cell<Option<[u64; 3]>>>,
+    /// Saving stopped (a restored backup replaces the library; the page reloads).
+    frozen: Rc<Cell<bool>>,
+}
+
+impl Sync {
+    pub fn new(files: Files, written: String, frozen: Rc<Cell<bool>>) -> Sync {
+        Sync { files, written: Rc::new(RefCell::new(written)), seen: Rc::new(Cell::new(None)), frozen }
+    }
+
+    /// Store the settings if they changed since the last save (cheap when they didn't).
+    pub fn save(&self) {
+        if self.frozen.get() {
+            return;
+        }
+        let revs = FILES.map(|n| self.files.revision(n));
+        if self.seen.get() == Some(revs) {
+            return;
+        }
+        self.seen.set(Some(revs));
+        let mut map = serde_json::Map::new();
+        let mut total = 0;
+        for name in FILES {
+            match self.files.len_of(name) {
+                Some(n) if total + n <= MAX_BYTES => {}
+                Some(n) => {
+                    log::info!("lightcraft: {name} ({n} bytes) is too large for account settings; it stays in this browser");
+                    continue;
+                }
+                None => continue,
+            }
+            let Some(text) = self.files.get(name).and_then(|d| String::from_utf8(d).ok()) else { continue };
+            total += text.len();
+            map.insert(name.to_string(), text.into());
+        }
+        let text = serde_json::Value::Object(map).to_string();
+        if *self.written.borrow() == text {
+            return;
+        }
+        let Some(s) = storage() else { return };
+        if let Err(e) = s.set_item(KEY, &text) {
+            // a stale copy would win over this browser's newer files at the next start
+            log::warn!("lightcraft: saving account settings failed ({e:?}); this browser's copy is used");
+            let _ = s.remove_item(KEY);
+            *self.written.borrow_mut() = String::new();
+            return;
+        }
+        *self.written.borrow_mut() = text;
+    }
+
+    /// Drop the account's copy, so a restored backup's own settings are used after the reload
+    /// (and then stored again).
+    pub fn forget(&self) {
+        if let Some(s) = storage() {
+            let _ = s.remove_item(KEY);
+        }
+    }
+
+    /// Also save when the page is hidden or unloaded (a tab can be closed without notice).
+    pub fn save_on_hide(&self) {
+        let Some(w) = web_sys::window() else { return };
+        let on_hidden = {
+            let sync = self.clone();
+            Closure::<dyn FnMut()>::new(move || {
+                let hidden = web_sys::window().and_then(|w| w.document()).is_some_and(|d| d.visibility_state() == web_sys::VisibilityState::Hidden);
+                if hidden {
+                    sync.save();
+                }
+            })
+        };
+        let on_pagehide = {
+            let sync = self.clone();
+            Closure::<dyn FnMut()>::new(move || sync.save())
+        };
+        if let Some(d) = w.document() {
+            let _ = d.add_event_listener_with_callback("visibilitychange", on_hidden.as_ref().unchecked_ref());
+        }
+        let _ = w.add_event_listener_with_callback("pagehide", on_pagehide.as_ref().unchecked_ref());
+        on_hidden.forget();
+        on_pagehide.forget();
+    }
+}
