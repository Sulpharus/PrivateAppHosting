{
  "$schema": "../../packages/manifest/schema.json",
  "specVersion": 1,
  "slug": "lightcraft",
  "name": "LightCraft",
  "description": "Fotobibliothek und RAW-Entwicklung im Browser, zerstörungsfrei",
  "kind": "static",
  "target": "cloudflare",
  "access": {
    "default": true
  },
  "data": {
    "mode": "private"
  },
  "wasm": true,
  "build": {
    "command": "node build.mjs",
    "output": "dist"
  },
  "i18n": {
    "languages": ["de", "en"],
    "default": "de"
  }
}
