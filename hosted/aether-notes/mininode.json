{
  "$schema": "https://mininode.app/schema/mininode.json",
  "specVersion": 1,
  "slug": "aether-notes",
  "name": "Aether Notes",
  "description": "Achtsames CRM für Kontakte, Notizen, Routinen und Aufgaben.",
  "kind": "spa",
  "target": "cloudflare",
  "access": {
    "default": false
  },
  "data": {
    "mode": "private"
  },
  "google": {
    "calendar": "read"
  },
  "build": {
    "command": "pnpm build",
    "output": "dist"
  }
}
