{
  "$schema": "https://mininode.app/schema/mininode.json",
  "specVersion": 1,
  "slug": "aether-notes",
  "name": "Aether Notes",
  "description": "Achtsames CRM für Kontakte, Notizen, Routinen und Aufgaben.",
  "kind": "spa",
  "target": "cloudflare",
  "access": {
    "default": false
  },
  "data": {
    "mode": "private"
  },
  "google": {
    "calendar": "read"
  },
  "build": {
    "command": "pnpm build",
    "output": "dist"
  },
  "i18n": {
    "languages": ["de", "en"],
    "default": "de"
  },
  "apis": [
    {
      "id": "nominatim",
      "name": "OpenStreetMap Nominatim",
      "baseUrl": "https://nominatim.openstreetmap.org",
      "auth": {
        "type": "none"
      },
      "docs": "https://operations.osmfoundation.org/policies/nominatim/",
      "reason": "Adressen von Kontakten und Treffen auf der Karte finden"
    }
  ],
  "suite": {
    "uses": [
      {
        "type": "event",
        "access": "delete",
        "why": "Treffen im Kalender mit Ort zeigen"
      }
    ]
  }
}
