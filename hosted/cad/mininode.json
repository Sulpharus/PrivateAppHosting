{
  "$schema": "../../packages/manifest/schema.json",
  "specVersion": 1,
  "slug": "cad",
  "name": "CAD",
  "description": "Konstruktionspläne, 3D-Modelle für 3D-Druck und CNC, Import und Export, mit KI-Assistent",
  "kind": "static",
  "target": "cloudflare",
  "access": {
    "default": true
  },
  "data": {
    "mode": "private"
  },
  "ai": {
    "models": ["claude-sonnet", "gemini-flash"],
    "monthlyBudgetEur": 5,
    "maxOutputTokens": 4000,
    "search": false
  },
  "i18n": {
    "languages": ["de", "en"],
    "default": "de"
  }
}
