+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+#ifndef MUSE_MIDI_WEBMIDIINPORT_H
+#define MUSE_MIDI_WEBMIDIINPORT_H
+
+#include "async/asyncable.h"
+#include "imidiinport.h"
+
+namespace muse::midi {
+//! MIDI input in the browser. The page asks for Web MIDI access and reports the inputs with
+//! WebMidiInPort::setDevices; connect() asks the page to listen to one input
+//! (Module.mnMidiConnect), whose messages come back through WebMidiInPort::receive.
+class WebMidiInPort : public IMidiInPort, public async::Asyncable
+{
+public:
+    void init();
+    void deinit();
+
+    MidiDeviceList availableDevices() const override;
+    async::Notification availableDevicesChanged() const override;
+
+    Ret connect(const MidiDeviceID& deviceID) override;
+    void disconnect() override;
+    bool isConnected() const override;
+    MidiDeviceID deviceID() const override;
+    async::Notification deviceChanged() const override;
+
+    async::Channel<tick_t, Event> eventReceived() const override;
+
+    //! "id\tname\n" per input, from the page.
+    static void setDevices(const std::string& list);
+    //! One MIDI 1.0 message packed as status | data1 << 8 | data2 << 16, from the page.
+    static void receive(uint32_t package);
+
+private:
+    void updateDevices(const std::string& list);
+    bool deviceExists(const MidiDeviceID& deviceID) const;
+
+    MidiDeviceList m_devices;
+    MidiDeviceID m_deviceID;
+    async::Notification m_availableDevicesChanged;
+    async::Notification m_deviceChanged;
+    async::Channel<tick_t, Event> m_eventReceived;
+};
+}
+
+#endif // MUSE_MIDI_WEBMIDIINPORT_H
