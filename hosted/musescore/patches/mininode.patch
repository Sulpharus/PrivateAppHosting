index fad6a767..51cd2384 100644
--- a/src/appshell/internal/startupscenario.cpp
+++ b/src/appshell/internal/startupscenario.cpp
@@ -24,6 +24,8 @@
 
 #include <QCoreApplication>
 
+#include <algorithm>
+
 #include "async/async.h"
 #include "translation.h"
 
@@ -152,7 +154,25 @@ void StartupScenario::runAfterSplashScreen()
 
     StartupModeType modeType = resolveStartupModeType();
     if (multiwindowsProvider()->windowCount() == 1 && sessionsManager()->hasProjectsForRestore()) {
+#ifdef MUSE_WEB_DESKTOP
+        //! MiniNode: closing the tab is how the browser app quits, so the last session ended
+        //! normally unless a score has unsaved changes to recover: ask only then, otherwise follow
+        //! the startup setting as after a normal quit.
+        const io::paths_t paths = configuration()->sessionProjectsPaths();
+        //! A new score that was never saved autosaves to the temporary path itself.
+        const io::path_t newProjectPath = projectConfiguration()->newProjectTemporaryPath();
+        const bool unsaved = std::any_of(paths.cbegin(), paths.cend(), [this, &newProjectPath](const io::path_t& path) {
+            return path == newProjectPath ? static_cast<bool>(fileSystem()->exists(path))
+                                          : projectAutoSaver()->projectHasUnsavedChanges(path);
+        });
+        if (unsaved) {
+            modeType = StartupModeType::Recovery;
+        } else if (modeType != StartupModeType::ContinueLastSession) {
+            sessionsManager()->reset();
+        }
+#else
         modeType = StartupModeType::Recovery;
+#endif
     }
 
     muse::async::Channel<Uri> opened = interactive()->opened();
@@ -297,6 +317,10 @@ void StartupScenario::showStartupDialogsIfNeed(StartupModeType modeType)
 
 bool StartupScenario::shouldShowWelcomeDialog(StartupModeType modeType) const
 {
+#ifdef MUSE_WEB_DESKTOP
