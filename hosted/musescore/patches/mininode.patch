+#if defined(Q_OS_WASM) && defined(MUSE_WEB_DESKTOP)
+//! Desktop edition: the page shows the file dialogs (the person's MiniNode files or the device,
+//! see Module.mnFileDialog in the page) and answers with paths in the Emscripten file system.
+//! A file to open is already written there; a path to save to is watched by the page, which hands
+//! every file written below it to the chosen place. A nested event loop waits for the answer (JSPI).
+namespace {
+struct SyncDialog {
+    QEventLoop* loop = nullptr;
+    bool done = false;
+    std::vector<std::string> paths;
+};
+
+SyncDialog* g_syncDialog = nullptr;
+
+void onSyncDialogDone(emscripten::val paths)
+{
+    if (!g_syncDialog) {
+        return;
+    }
+
+    if (paths.isArray()) {
+        const unsigned count = paths["length"].as<unsigned>();
+        for (unsigned i = 0; i < count; ++i) {
+            g_syncDialog->paths.push_back(paths[i].as<std::string>());
+        }
+    }
+
+    g_syncDialog->done = true;
+    if (g_syncDialog->loop) {
+        g_syncDialog->loop->quit();
+    }
+}
+
+emscripten::val toJsArray(const std::vector<std::string>& list)
+{
+    emscripten::val array = emscripten::val::array();
+    for (const std::string& item : list) {
+        array.call<void>("push", item);
+    }
+    return array;
+}
+
+std::vector<std::string> runSyncDialog(const std::string& kind, const std::string& title, const io::path_t& path,
+                                       const std::vector<std::string>& filter, bool multiple)
+{
+    IF_ASSERT_FAILED(!g_syncDialog) {
+        LOGE() << "a file dialog is already open";
+        return {};
+    }
+
+    SyncDialog dialog;
+    QEventLoop loop;
+    dialog.loop = &loop;
+    g_syncDialog = &dialog;
+
+    emscripten::val options = emscripten::val::object();
+    options.set("kind", kind);
+    options.set("title", title);
+    options.set("path", path.toStdString());
+    options.set("filter", toJsArray(filter));
+    options.set("multiple", multiple);
+
+    emscripten::val::module_property("mnFileDialog")(options, emscripten::val::module_property("onSyncDialogDone"));
+
+    if (!dialog.done) {
+        loop.exec();
+    }
+
+    g_syncDialog = nullptr;
+    return dialog.paths;
+}
+}
+
+EMSCRIPTEN_BINDINGS(WebInteractiveSync) {
+    emscripten::function("onSyncDialogDone", &onSyncDialogDone);
+}
+#endif
