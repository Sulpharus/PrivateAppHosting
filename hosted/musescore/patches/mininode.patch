+###########################################
+# CONFIGURE: Web App, desktop edition (MiniNode)
+###########################################
+# The desktop application (appshell, dock windows, workspaces, every import and export) built
+# for WebAssembly. It reuses the web pieces of app-web (JS bridge, web audio driver, web
+# interactive) and needs Qt for WebAssembly with JSPI, so modal dialogs work (Chrome, Edge).
+# Online services are left out: MuseScore.com, MuseHub, Muse Sounds, Learn, updates, crash reports.
+if(BUILD_CONFIGURATION STREQUAL "APP-MININODE")
+    set(MUE_CONFIGURATION_IS_APPWEB ON)
+    set(MUE_CONFIGURATION_IS_APPMININODE ON)
+    set(MUSE_CONFIGURATION_IS_WEB ON)
+    set(MUSE_WEB_DESKTOP ON)
