+        QPixmap stored;
+        const muse::io::path_t storedPath = globalConfiguration()->userAppDataPath() + "/thumbnails/"
+                                            + muse::io::filename(filePath) + ".png";
+        if (stored.load(storedPath.toQString())) {
+            return resolve(stored);
+        }
+        return reject(int(Ret::Code::UnknownError), "No thumbnail");
+    });
+#else
     return Promise<QPixmap>([this, filePath](auto resolve, auto reject) {
