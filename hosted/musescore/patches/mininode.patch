diff --git a/src/framework/midi/internal/platform/web/webmidiinport.cpp b/src/framework/midi/internal/platform/web/webmidiinport.cpp
new file mode 100644
index 00000000..e857a0ab
--- /dev/null
+++ b/src/framework/midi/internal/platform/web/webmidiinport.cpp
@@ -0,0 +1,204 @@
+/*
+ * SPDX-License-Identifier: GPL-3.0-only
+ * MuseScore-CLA-applies
+ *
+ * MuseScore
+ * Music Composition & Notation
+ *
+ * Copyright (C) 2026 MuseScore Limited and others
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 3 as
+ * published by the Free Software Foundation.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+#include "webmidiinport.h"
+
+#include <emscripten.h>
+
+#include "async/async.h"
+#include "global/translation.h"
+#include "midierrors.h"
+#include "log.h"
+
+using namespace muse;
+using namespace muse::midi;
+
+namespace {
+WebMidiInPort* s_port = nullptr;
+}
+
+void WebMidiInPort::init()
+{
+    s_port = this;
+    // The page reports its inputs once the port is there (now, or when it installs its hooks).
+    MAIN_THREAD_EM_ASM({
+        Module.mnMidiPortReady = true;
+        if (Module.mnMidiReady) {
+            Module.mnMidiReady();
+        }
+    });
+}
+
+void WebMidiInPort::deinit()
+{
+    disconnect();
+    s_port = nullptr;
+}
+
+void WebMidiInPort::setDevices(const std::string& list)
+{
+    // Called from a browser event: run it in the editor's own loop.
+    if (!s_port) {
+        return;
+    }
+    async::Async::call(s_port, [list]() {
+        if (s_port) {
+            s_port->updateDevices(list);
+        }
+    });
+}
+
+void WebMidiInPort::receive(uint32_t package)
+{
+    if (!s_port) {
+        return;
+    }
+    async::Async::call(s_port, [package]() {
+        if (!s_port || !s_port->isConnected()) {
+            return;
+        }
+        Event e = Event::fromMidi10Package(package).toMIDI20();
+        if (e) {
+            s_port->m_eventReceived.send(0, e);
+        }
+    });
+}
+
+void WebMidiInPort::updateDevices(const std::string& list)
+{
+    MidiDeviceList devices;
+    size_t start = 0;
+    while (start < list.size()) {
+        size_t end = list.find('\n', start);
+        if (end == std::string::npos) {
+            end = list.size();
+        }
+        const std::string line = list.substr(start, end - start);
+        const size_t tab = line.find('\t');
+        if (tab != std::string::npos && tab > 0) {
+            devices.push_back({ line.substr(0, tab), line.substr(tab + 1) });
+        }
+        start = end + 1;
+    }
+
+    // At start the page knows no inputs yet, so the editor picks "No device". That was no choice:
+    // forget it when the first inputs appear, so the editor takes the chosen or the first one
+    // (MidiInputOutputController::checkConnection). A "No device" chosen in the preferences
+    // still wins there.
+    const bool firstInputs = m_devices.empty() && !devices.empty();
+    m_devices = devices;
+    if (isConnected() && !deviceExists(m_deviceID)) {
+        disconnect();
+    } else if (firstInputs && m_deviceID == NONE_DEVICE_ID) {
+        m_deviceID.clear();
+    }
+    m_availableDevicesChanged.notify();
+}
+
+MidiDeviceList WebMidiInPort::availableDevices() const
+{
+    MidiDeviceList ret;
+    ret.push_back({ NONE_DEVICE_ID, muse::trc("midi", "No device") });
+    ret.insert(ret.end(), m_devices.begin(), m_devices.end());
+    return ret;
+}
+
+async::Notification WebMidiInPort::availableDevicesChanged() const
+{
+    return m_availableDevicesChanged;
+}
+
+bool WebMidiInPort::deviceExists(const MidiDeviceID& deviceID) const
+{
+    for (const MidiDevice& device : availableDevices()) {
+        if (device.id == deviceID) {
+            return true;
+        }
+    }
+    return false;
+}
+
+Ret WebMidiInPort::connect(const MidiDeviceID& deviceID)
+{
+    if (!deviceExists(deviceID)) {
+        return make_ret(Err::MidiFailedConnect, "not found device, id: " + deviceID);
+    }
+
+    m_deviceID = deviceID;
+    const std::string listened = deviceID == NONE_DEVICE_ID ? std::string() : deviceID;
+    MAIN_THREAD_EM_ASM({
+        if (Module.mnMidiConnect) {
+            Module.mnMidiConnect(UTF8ToString($0));
+        }
+    }, listened.c_str());
+
+    m_deviceChanged.notify();
+    return make_ok();
+}
+
+void WebMidiInPort::disconnect()
+{
+    if (m_deviceID.empty()) {
+        return;
+    }
+    m_deviceID.clear();
+    MAIN_THREAD_EM_ASM({
+        if (Module.mnMidiConnect) {
+            Module.mnMidiConnect('');
+        }
+    });
+    m_deviceChanged.notify();
+}
+
+bool WebMidiInPort::isConnected() const
+{
+    return !m_deviceID.empty() && m_deviceID != NONE_DEVICE_ID;
+}
+
+MidiDeviceID WebMidiInPort::deviceID() const
+{
+    return m_deviceID;
+}
+
+async::Notification WebMidiInPort::deviceChanged() const
+{
+    return m_deviceChanged;
+}
+
+async::Channel<tick_t, Event> WebMidiInPort::eventReceived() const
+{
+    return m_eventReceived;
+}
+
+// Called by the page (web/mn-midi.js in MiniNode).
+extern "C" {
+EMSCRIPTEN_KEEPALIVE
+void mnMidiDevices(const char* list)
+{
+    WebMidiInPort::setDevices(list ? std::string(list) : std::string());
+}
+
+EMSCRIPTEN_KEEPALIVE
+void mnMidiIn(uint32_t package)
+{
+    WebMidiInPort::receive(package);
+}
+}
