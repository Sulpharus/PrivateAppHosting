+#pragma once
+
+#include "print/iprintprovider.h"
+#include "project/inotationwritersregister.h"
+#include "global/modularity/ioc.h"
+
+namespace mu::appjs {
+//! Printing in the browser: the score is written as PDF and handed to the page
+//! (Module.mnPrintPdf), which opens it in the browser's PDF viewer to print from there.
+class WebPrintProvider : public print::IPrintProvider, public muse::Contextable
+{
+    muse::ContextInject<project::INotationWritersRegister> writers = { this };
+
+public:
+    WebPrintProvider(const muse::modularity::ContextPtr& iocCtx)
+        : muse::Contextable(iocCtx) {}
+
+    muse::Ret printNotation(notation::INotationPtr notation) override;
+};
+}
