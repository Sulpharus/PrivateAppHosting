+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+#include "webprintprovider.h"
+
+#include <emscripten/val.h>
+
+#include "global/io/buffer.h"
+
+#include "log.h"
+
+using namespace muse;
+using namespace mu::appjs;
+
+Ret WebPrintProvider::printNotation(notation::INotationPtr notation)
+{
+    IF_ASSERT_FAILED(notation) {
+        return make_ret(Ret::Code::InternalError);
+    }
+
+    project::INotationWriterPtr writer = writers() ? writers()->writer("pdf") : nullptr;
+    if (!writer) {
+        LOGE() << "no PDF writer";
+        return make_ret(Ret::Code::NotSupported);
+    }
+
+    io::Buffer buffer;
+    buffer.open(io::IODevice::WriteOnly);
+    Ret ret = writer->write(notation, buffer);
+    buffer.close();
+    if (!ret) {
+        return ret;
+    }
+
+    const ByteArray& data = buffer.data();
+    emscripten::val bytes = emscripten::val::global("Uint8Array").new_(
+        emscripten::typed_memory_view(data.size(), data.constData()));
+    emscripten::val::module_property("mnPrintPdf")(bytes);
+    return make_ok();
+}
