diff --git a/SetupConfigure.cmake b/SetupConfigure.cmake
index 501d10e8..958978d2 100644
--- a/SetupConfigure.cmake
+++ b/SetupConfigure.cmake
@@ -192,6 +192,73 @@ if(BUILD_CONFIGURATION STREQUAL "APP-WEB")
 
 endif()
 
+###########################################
+# CONFIGURE: Web App, desktop edition (MiniNode)
+###########################################
+# The desktop application (appshell, dock windows, workspaces, every import and export) built
+# for WebAssembly. It reuses the web pieces of app-web (JS bridge, web audio driver, web
+# interactive) and needs Qt for WebAssembly with JSPI, so modal dialogs work (Chrome, Edge).
+# Online services are left out: MuseScore.com, MuseHub, Muse Sounds, Learn, updates, crash reports.
+if(BUILD_CONFIGURATION STREQUAL "APP-MININODE")
+    set(MUE_CONFIGURATION_IS_APPWEB ON)
+    set(MUE_CONFIGURATION_IS_APPMININODE ON)
+    set(MUSE_CONFIGURATION_IS_WEB ON)
+    set(MUSE_WEB_DESKTOP ON)
+    # Qt is built with wasm exceptions (needed for JSPI); every library must use the same
+    # setjmp/longjmp model, or the link fails (FreeType: emscripten_longjmp). Targets that use Qt
+    # get -fwasm-exceptions from it; libraries built with -fno-exceptions (fdk-aac) keep that.
+    string(APPEND CMAKE_C_FLAGS " -sSUPPORT_LONGJMP=wasm")
+    string(APPEND CMAKE_CXX_FLAGS " -sSUPPORT_LONGJMP=wasm")
+
+    set(QT_ADD_LINGUISTTOOLS OFF)
+    set(QT_ADD_CONCURRENT OFF)
+    set(QT_QPROCESS_SUPPORTED OFF)
+    set(QT_CONCURRENT_SUPPORTED OFF)
+    set(MUSE_THREADS_SUPPORT OFF)
+
+    set(MUSE_MODULE_UI_SYSTEMDRAG_SUPPORTED OFF)
+    set(MUSE_MODULE_UI_SYNCINTERACTIVE_SUPPORTED ON)
+
+    set(MUE_GENERAL_APP ON)
+    set(MUSE_MODULE_AUDIO_WORKMODE 2) # driver callback
+    set(MUSE_ENABLE_UNIT_TESTS OFF)
+
+    # Desktop features
+    set(MUSE_MODULE_DOCKWINDOW ON)
+    set(MUSE_MODULE_WORKSPACE ON)
+    set(MUSE_MODULE_SHORTCUTS ON)
+    set(MUSE_MODULE_ACCESSIBILITY ON)
+    set(MUSE_MODULE_LANGUAGES ON)
+    set(MUSE_MODULE_TOURS OFF)
+    set(MUSE_MODULE_EXTENSIONS ON)
+    set(MUSE_MODULE_AUDIO_EXPORT ON)
+    set(MUE_BUILD_BRAILLE_MODULE ON)
+
+    # Not possible in a browser tab
+    set(MUSE_MODULE_AUDIOPLUGINS OFF)
+    set(MUSE_MODULE_VST OFF)
+    set(MUSE_MODULE_MIDI OFF)
+    set(MUSE_MODULE_MIDIREMOTE OFF)
+    set(MUSE_MODULE_MULTIWINDOWS OFF)
+    set(MUSE_MODULE_AUTOBOT OFF)
+    set(MUE_BUILD_PRINT_MODULE OFF)
+    set(MUE_BUILD_CONVERTER_MODULE OFF)
+    set(MUE_ENABLE_CONSOLEAPP OFF)
+    set(MUE_ENABLE_SPLASHSCREEN OFF)
+    set(MUE_BUILD_IMPEXP_VIDEOEXPORT_MODULE OFF)
+
+    # Online services and promotions
+    set(MUSE_MODULE_NETWORK OFF)
+    set(MUSE_MODULE_CLOUD OFF)
+    set(MUSE_MODULE_LEARN OFF)
+    set(MUSE_MODULE_UPDATE OFF)
+    set(MUSE_MODULE_MUSESAMPLER OFF)
+    set(MUE_BUILD_MUSESOUNDS_MODULE OFF)
+    set(MUSE_MODULE_DIAGNOSTICS_CRASHPAD_CLIENT OFF)
+
+    set(MUE_INSTALL_SOUNDFONT OFF)
+endif()
+
 ###########################################
 # CONFIGURE: VTest
 ###########################################
