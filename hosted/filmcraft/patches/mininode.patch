+/// MiniNode: save changed settings when the page is hidden or left (no frame may follow), and ask
+/// before leaving with unsaved project changes.
+fn install_page_listeners(runner: &eframe::WebRunner) -> Result<(), JsValue> {
+    let window = web_sys::window().ok_or("no window")?;
+    let doc = window.document().ok_or("no document")?;
+    let flush = |r: &eframe::WebRunner| {
+        if let Some(mut w) = r.app_mut::<WebApp>() {
+            let w = &mut *w;
+            w.prefs.flush(&w.app);
+        }
+    };
+    let r = runner.clone();
+    let d = doc.clone();
+    let on_visibility = Closure::<dyn FnMut()>::new(move || {
+        if d.hidden() {
+            flush(&r);
+        }
+    });
+    doc.add_event_listener_with_callback("visibilitychange", on_visibility.as_ref().unchecked_ref())?;
+    on_visibility.forget();
+    let r = runner.clone();
+    let on_pagehide = Closure::<dyn FnMut()>::new(move || flush(&r));
+    window.add_event_listener_with_callback("pagehide", on_pagehide.as_ref().unchecked_ref())?;
+    on_pagehide.forget();
+    let r = runner.clone();
+    let on_beforeunload = Closure::<dyn FnMut(web_sys::Event)>::new(move |e: web_sys::Event| {
+        if r.app_mut::<WebApp>().is_some_and(|w| w.app.session.is_dirty()) {
+            e.prevent_default();
+        }
+    });
+    window.add_event_listener_with_callback("beforeunload", on_beforeunload.as_ref().unchecked_ref())?;
+    on_beforeunload.forget();
+    Ok(())
+}
