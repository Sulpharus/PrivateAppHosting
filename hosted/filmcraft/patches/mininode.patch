diff --git a/apps/filmcraft-web/src/prefs.rs b/apps/filmcraft-web/src/prefs.rs
new file mode 100644
index 0000000..3193a69
--- /dev/null
+++ b/apps/filmcraft-web/src/prefs.rs
@@ -0,0 +1,119 @@
+//! MiniNode: settings in `localStorage` (the desktop keeps them as files in the data directory,
+//! which the browser build has none of). One key, [`KEY`], holds a JSON document:
+//!
+//! - `preferences`: Settings ([`Preferences`], the desktop `preferences.json`);
+//! - `workspaces`: Window ▸ Workspaces (the desktop `workspaces.json`);
+//! - `effectPresets`: user effect presets; `exportPresets`: user export presets and favourites.
+//!
+//! Keyboard shortcut sets, label presets and graphics templates stay as they are (files only).
+//! Loaded before the UI is built; written when the serialised document changes, checked at most
+//! once a second and when the page is hidden.
+
+use filmcraft_engine::Session;
+use filmcraft_engine::autosave::Preferences;
+use filmcraft_ui_egui::FilmcraftApp;
+use serde_json::{Value, json};
+
+pub const KEY: &str = "filmcraft.preferences";
+/// A larger document is not written (it would be an unusual preset library); the log says so.
+const MAX_BYTES: usize = 512 * 1024;
+
+fn storage() -> Option<web_sys::Storage> {
+    web_sys::window().and_then(|w| w.local_storage().ok().flatten())
+}
+
+/// The stored document, if there is a readable one.
+pub fn read() -> Option<Value> {
+    let s = storage()?.get_item(KEY).ok().flatten()?;
+    serde_json::from_str::<Value>(&s).ok().filter(Value::is_object)
+}
+
+/// Apply the stored settings and presets to a new session (before [`FilmcraftApp::new`], which
+/// reads the interface language from them). Without stored settings, Appearance Mode is Auto
+/// (follows `prefers-color-scheme`) instead of the desktop's Dark.
+pub fn restore_session(session: &mut Session, doc: Option<&Value>) {
+    let prefs = match doc.and_then(|d| d.get("preferences")) {
+        Some(v) => Preferences::from_value(v.clone()),
+        None => {
+            let mut p = session.prefs.clone();
+            p.appearance.appearance_mode = "auto".into();
+            p.appearance.sync_color_theme();
+            p
+        }
+    };
+    if let Err(e) = session.set_prefs(prefs) {
+        log::warn!("preferences: {e}");
+    }
+    let Some(doc) = doc else { return };
+    if let Some(v) = doc.get("effectPresets").cloned().and_then(|v| serde_json::from_value(v).ok()) {
+        session.presets.user = v;
+    }
+    if let Some(e) = doc.get("exportPresets") {
+        if let Some(v) = e.get("presets").cloned().and_then(|v| serde_json::from_value(v).ok()) {
+            session.export_presets.user = v;
+        }
+        if let Some(v) = e.get("favorites").cloned().and_then(|v| serde_json::from_value(v).ok()) {
+            session.export_presets.favorites = v;
+        }
+    }
+}
+
+/// Apply the stored workspaces (before the first frame reopens the current one).
+pub fn restore_app(app: &mut FilmcraftApp, doc: Option<&Value>) {
+    if let Some(v) = doc.and_then(|d| d.get("workspaces")).cloned().and_then(|v| serde_json::from_value(v).ok()) {
+        app.workspaces = v;
+    }
+}
+
+fn document(app: &FilmcraftApp) -> String {
+    let s = &app.session;
+    json!({
+        "version": 1,
+        "preferences": s.prefs.to_value(),
+        "workspaces": app.workspaces,
+        "effectPresets": s.presets.user,
+        "exportPresets": { "presets": s.export_presets.user, "favorites": s.export_presets.favorites },
+    })
+    .to_string()
+}
+
+/// Writes the document when it changed.
+#[derive(Default)]
+pub struct Saver {
+    last: Option<String>,
+    checked: f64,
+}
+
+impl Saver {
+    /// Remember what was restored, so an unchanged start writes nothing.
+    pub fn new(app: &FilmcraftApp) -> Self {
+        Self { last: Some(document(app)), checked: 0.0 }
+    }
+
+    /// Called every frame; compares at most once a second.
+    pub fn tick(&mut self, app: &FilmcraftApp, ctx: &egui::Context) {
+        let now = ctx.input(|i| i.time);
+        let wait = 1.0 - (now - self.checked);
+        if wait > 0.0 {
+            // one follow-up frame, so a change made just after a check is not left waiting
+            ctx.request_repaint_after(std::time::Duration::from_secs_f64(wait));
+            return;
+        }
+        self.checked = now;
+        self.flush(app);
+    }
+
+    /// Write now if the document changed (also on `visibilitychange` → hidden and `pagehide`).
+    pub fn flush(&mut self, app: &FilmcraftApp) {
+        let doc = document(app);
+        if self.last.as_deref() == Some(doc.as_str()) {
+            return;
+        }
+        if doc.len() > MAX_BYTES {
+            log::warn!("preferences: {} KB is too large for localStorage; not saved", doc.len() / 1024);
+        } else if let Some(Err(e)) = storage().map(|s| s.set_item(KEY, &doc)) {
+            log::warn!("preferences: localStorage: {e:?}");
+        }
+        self.last = Some(doc);
+    }
+}
