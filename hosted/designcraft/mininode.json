{
  "$schema": "../../packages/manifest/schema.json",
  "specVersion": 1,
  "slug": "designcraft",
  "name": "DesignCraft",
  "description": "Layout und Satz im Browser: Seiten gestalten wie in einem Desktop-Publishing-Programm",
  "kind": "static",
  "target": "cloudflare",
  "access": {
    "default": true
  },
  "data": {
    "mode": "none"
  },
  "wasm": true,
  "build": {
    "command": "node build.mjs",
    "output": "dist"
  },
  "i18n": {
    "languages": ["de", "en"],
    "default": "de"
  }
}
