+/// MiniNode: save the settings when the page is hidden or left, and warn before leaving with
+/// unsaved documents.
+fn install_page_listeners(runner: &eframe::WebRunner) -> Result<(), wasm_bindgen::JsValue> {
+    let window = web_sys::window().ok_or_else(|| wasm_bindgen::JsValue::from_str("no window"))?;
+    let document = window.document().ok_or_else(|| wasm_bindgen::JsValue::from_str("no document"))?;
+    runner.add_event_listener(&document, "visibilitychange", |_: web_sys::Event, app_runner| {
+        let hidden = web_sys::window()
+            .and_then(|w| w.document())
+            .is_some_and(|d| d.visibility_state() == web_sys::VisibilityState::Hidden);
+        if hidden {
+            let shell = app_runner.app_mut::<WebShell>();
+            shell.persisted.save(&shell.app, 0.0, true);
+        }
+    })?;
+    runner.add_event_listener(&window, "pagehide", |_: web_sys::Event, app_runner| {
+        let shell = app_runner.app_mut::<WebShell>();
+        shell.persisted.save(&shell.app, 0.0, true);
+    })?;
+    runner.add_event_listener(&window, "beforeunload", |event: web_sys::Event, app_runner| {
+        if app_runner.app_mut::<WebShell>().app.session.documents().iter().any(|d| d.is_dirty()) {
+            event.prevent_default();
+        }
+    })?;
+    Ok(())
+}
