@@ -0,0 +1,109 @@
+//! MiniNode: the desktop's `ui.json` and `prefs.json`, kept in `localStorage` as one entry
+//! (`{"ui": …, "prefs": …}`). MiniNode syncs `localStorage` to the person's account, so the
+//! settings follow them across devices.
+//!
+//! Without a saved choice, the interface language follows the page (`<html lang>`, set by
+//! MiniNode). That pick is left out of the saved entry until the person changes it in the app, so
+//! it keeps following the page. The brightness keeps the app's own default (its light levels
+//! looked grey to people used to it).
+
+use designcraft_ui_egui::theme::Brightness;
+use designcraft_ui_egui::{DesignApp, UiState};
+
+const KEY: &str = "designcraft.preferences";
+
+pub struct Persisted {
+    /// The entry as last written (or loaded), to write only when something changed.
+    last: String,
+    checked: f64,
+    auto_language: Option<String>,
+    auto_brightness: Option<Brightness>,
+}
+
+fn storage() -> Option<web_sys::Storage> {
+    web_sys::window()?.local_storage().ok()?
+}
+
+/// Apply the saved settings (and the page's defaults) before the first frame.
+pub fn load(app: &mut DesignApp) -> Persisted {
+    let saved: serde_json::Value = storage()
+        .and_then(|s| s.get_item(KEY).ok().flatten())
+        .and_then(|text| serde_json::from_str(&text).ok())
+        .unwrap_or_default();
+    if let Ok(bytes) = serde_json::to_vec(&saved["ui"])
+        && let Ok(ui) = UiState::from_preferences_json(&bytes)
+    {
+        app.ui = ui;
+    }
+    if let Ok(prefs) = serde_json::from_value::<designcraft_engine::Prefs>(saved["prefs"].clone()) {
+        app.session.prefs = prefs;
+    }
+    let mut auto_language = None;
+    if saved["ui"].get("language").is_none() {
+        app.ui.language = page_language();
+        auto_language = Some(app.ui.language.clone());
+    }
+    let auto_brightness: Option<Brightness> = None;
+    let mut persisted = Persisted { last: String::new(), checked: 0.0, auto_language, auto_brightness };
+    persisted.last = persisted.serialize(app).unwrap_or_default();
+    persisted
+}
+
+impl Persisted {
+    /// Write the settings when they changed: at most once a second, or now with `force`.
+    pub fn save(&mut self, app: &DesignApp, now: f64, force: bool) {
+        if !force && now - self.checked < 1.0 {
+            return;
+        }
+        self.checked = now;
+        let Some(text) = self.serialize(app) else { return };
+        if text == self.last {
+            return;
+        }
+        if let Some(storage) = storage()
+            && let Err(e) = storage.set_item(KEY, &text)
+        {
+            log::warn!("couldn't save preferences: {e:?}");
+        }
+        // Also after a failed write: retry on the next change, not every second.
+        self.last = text;
+    }
+
+    fn serialize(&mut self, app: &DesignApp) -> Option<String> {
+        // Changed in the app: an explicit choice from now on, saved like any other setting.
+        if self.auto_language.as_ref().is_some_and(|l| *l != app.ui.language) {
+            self.auto_language = None;
+        }
+        if self.auto_brightness.is_some_and(|b| b != app.ui.brightness) {
+            self.auto_brightness = None;
+        }
+        let mut ui = serde_json::to_value(&app.ui).ok()?;
+        if let Some(fields) = ui.as_object_mut() {
+            if self.auto_language.is_some() {
+                fields.remove("language");
+            }
+            if self.auto_brightness.is_some() {
+                fields.remove("brightness");
+            }
+        }
+        serde_json::to_string(&serde_json::json!({"ui": ui, "prefs": app.session.prefs})).ok()
+    }
+}
+
+/// The interface language for `<html lang>` (`de` → German, `en` or unknown → English, `""`).
+fn page_language() -> String {
+    let lang = web_sys::window()
+        .and_then(|w| w.document())
+        .and_then(|d| d.document_element())
+        .and_then(|e| e.get_attribute("lang"))
+        .unwrap_or_default()
+        .to_ascii_lowercase();
+    let primary = lang.split('-').next().unwrap_or_default();
+    designcraft_ui_egui::i18n::LANGUAGES
+        .iter()
+        .map(|(code, _)| *code)
+        .find(|code| !code.is_empty() && (*code == lang || *code == primary))
+        .unwrap_or_default()
+        .to_string()
+}
+
