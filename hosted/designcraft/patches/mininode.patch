+#[cfg(target_arch = "wasm32")]
+static CLOCK: std::sync::OnceLock<fn() -> i64> = std::sync::OnceLock::new();
+
+/// MiniNode: the wall clock for [`now`] on wasm (seconds since the Unix epoch), set once at start.
+#[cfg(target_arch = "wasm32")]
+pub fn set_clock(clock: fn() -> i64) {
+    let _ = CLOCK.set(clock);
+}
