+fn read_prefs() -> Option<String> {
+    local_storage()?.get_item(PREFS_KEY).ok().flatten()
+}
+
+fn write_prefs(text: &str) -> Result<(), String> {
+    local_storage().ok_or("no localStorage")?.set_item(PREFS_KEY, text).map_err(|e| format!("{e:?}"))
+}
+
+/// MiniNode syncs localStorage to the person's account, so every write reaches the server.
+/// Preference saves are written at most once per [`PREFS_WRITE_INTERVAL_MS`]: a save inside it
+/// waits (only the newest text is kept) for a timer, or for the page being hidden or closed.
+const PREFS_WRITE_INTERVAL_MS: f64 = 1000.0;
+
+#[derive(Default)]
+struct PrefsWriter {
+    /// The newest preferences not yet written.
+    pending: Option<String>,
+    /// When the last write happened (`Date.now()`, ms).
+    written_at: f64,
+    /// A flush timer is set.
+    timer: bool,
+    /// A delayed write failed; the next save reports it so the app retries and says so.
+    error: Option<String>,
+}
+
+type PrefsQueue = Rc<RefCell<PrefsWriter>>;
+
+fn queue_prefs(queue: &PrefsQueue, text: &str) -> Result<(), String> {
+    let now = js_sys::Date::now();
+    let mut q = queue.borrow_mut();
+    if !q.timer && now - q.written_at >= PREFS_WRITE_INTERVAL_MS {
+        q.pending = None;
+        q.error = None;
+        q.written_at = now;
+        return write_prefs(text);
+    }
+    q.pending = Some(text.to_owned());
+    if !q.timer {
+        q.timer = true;
+        let wait = (PREFS_WRITE_INTERVAL_MS - (now - q.written_at)).max(0.0);
+        let flush = queue.clone();
+        let cb = wasm_bindgen::closure::Closure::once_into_js(move || {
+            flush.borrow_mut().timer = false;
+            flush_prefs(&flush);
+        });
+        let set = web_sys::window().map(|w| w.set_timeout_with_callback_and_timeout_and_arguments_0(cb.unchecked_ref(), wait.ceil() as i32));
+        if !matches!(set, Some(Ok(_))) {
+            q.timer = false;
+            drop(q);
+            flush_prefs(queue);
+            return queue.borrow_mut().error.take().map_or(Ok(()), Err);
+        }
+    }
+    q.error.take().map_or(Ok(()), Err)
+}
+
+/// Write the waiting preferences now. A failure keeps them waiting for the next save or flush.
+fn flush_prefs(queue: &PrefsQueue) {
+    let mut q = queue.borrow_mut();
+    let Some(text) = q.pending.take() else { return };
+    q.written_at = js_sys::Date::now();
+    if let Err(e) = write_prefs(&text) {
+        log::error!("Could not save preferences: {e}");
+        q.pending = Some(text);
+        q.error = Some(e);
+    }
+}
+
+/// Write waiting preferences when the page is hidden or closed: the frame loop and timers may not
+/// run again.
+fn flush_prefs_on_hide(queue: PrefsQueue) {
+    use wasm_bindgen::closure::Closure;
+    let Some(window) = web_sys::window() else { return };
+    // Flushing early when the page comes back is harmless, so neither event is filtered.
+    let cb = Closure::<dyn FnMut()>::new(move || flush_prefs(&queue));
+    let ok = window.add_event_listener_with_callback("pagehide", cb.as_ref().unchecked_ref()).is_ok();
+    let ok = window.document().is_some_and(|d| d.add_event_listener_with_callback("visibilitychange", cb.as_ref().unchecked_ref()).is_ok()) || ok;
+    if ok {
+        cb.forget();
+    }
+}
+
+/// `<html lang>`, which MiniNode sets to the person's language (`de` or `en`).
+fn page_language() -> Option<String> {
+    let lang = web_sys::window()?.document()?.document_element()?.get_attribute("lang")?;
+    (!lang.trim().is_empty()).then_some(lang)
+}
+
+/// The person's display name, which MiniNode puts in `<html data-mn-user>` (missing without one).
+fn mininode_user() -> Option<String> {
+    let name = web_sys::window()?.document()?.document_element()?.get_attribute("data-mn-user")?;
+    let name = name.trim();
+    (!name.is_empty()).then(|| name.to_owned())
+}
