{
  "$schema": "../../packages/manifest/schema.json",
  "specVersion": 1,
  "slug": "photocraft",
  "name": "PhotoCraft",
  "description": "Bildbearbeitung im Browser mit Ebenen, Masken und Filtern, nach dem Vorbild von Photoshop",
  "kind": "static",
  "target": "cloudflare",
  "access": {
    "default": true
  },
  "data": {
    "mode": "none"
  },
  "wasm": true,
  "build": {
    "command": "node build.mjs",
    "output": "dist"
  },
  "i18n": {
    "languages": ["de", "en"],
    "default": "de"
  }
}
