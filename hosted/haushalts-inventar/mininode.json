{
  "$schema": "../../packages/manifest/schema.json",
  "specVersion": 1,
  "slug": "haushalts-inventar",
  "name": "Haushaltsinventar",
  "description": "Haushaltsinventar mit Garantien, Kaufbelegen, Wartungsterminen und Besitzern",
  "kind": "spa",
  "target": "cloudflare",
  "access": {
    "default": true
  },
  "data": {
    "mode": "shared-account"
  },
  "build": {
    "command": "pnpm build",
    "output": "dist"
  },
  "i18n": {
    "languages": ["de", "en"],
    "default": "de"
  }
}
