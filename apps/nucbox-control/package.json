{
  "name": "@mininode/nucbox-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/main.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/main.mjs --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@mininode/gate": "workspace:*",
    "aws4fetch": "1.0.20",
    "hono": "4.13.8",
    "undici": "8.11.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@mininode/config": "workspace:*",
    "@types/node": "22.19.1",
    "esbuild": "0.28.1",
    "jose": "6.2.12",
    "vitest": "5.0.1"
  }
}
