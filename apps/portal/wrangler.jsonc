{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mininode-portal",
  "account_id": "d690896e2d267adb0dd97027832767e5",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-23",
  "routes": [{ "pattern": "mininode.app", "custom_domain": true }],
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*"]
  },
  "vars": {
    "SUPABASE_URL": "https://ojicmpgqvoyakigvubek.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_jv1tZqYWg51sNxJ5-GjMMw_tZqa1s1C",
    "API_URL": "https://api.mininode.app",
    "AI_URL": "https://ai.mininode.app",
    "COOKIE_DOMAIN": ".mininode.app",
    "EMAIL_ENABLED": "false"
  }
}
