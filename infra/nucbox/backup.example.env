# /etc/mininode/backup.env (mode 600, root)
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
RESTIC_PASSWORD=                 # openssl rand -base64 32 — also store it in your password manager!
RESTIC_LOCAL_REPO=/mnt/backup/restic
RESTIC_R2_REPO=s3:https://<account-id>.r2.cloudflarestorage.com/mininode-backups/restic
AWS_ACCESS_KEY_ID=               # R2 API token: Object Read & Write on mininode-backups
AWS_SECRET_ACCESS_KEY=
HEALTHCHECK_URL=https://hc-ping.com/<uuid>
DRILL_HEALTHCHECK_URL=https://hc-ping.com/<uuid>
