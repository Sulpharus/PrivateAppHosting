#!/usr/bin/env bash
# Forced command of the `deploy` SSH user; runs as root through a single sudoers rule:
#   authorized_keys: restrict,command="sudo -n /usr/local/bin/nucbox-deploy \"$SSH_ORIGINAL_COMMAND\"" ssh-ed25519 …
#   sudoers:         deploy ALL=(root) NOPASSWD: /usr/local/bin/nucbox-deploy
# CI can only ask for exactly these rollouts, nothing else:
#
#   <slug> sha256:<digest>              container app ghcr.io/<owner>/mininode-<slug>@<digest>
#   platform control sha256:<digest>    nucbox-control
#   platform wine sha256:<digest>       Wine runtime image (tagged :current for new sessions)
#   library <slug> <entry>              App-Bibliothek: install or update a curated program
#   remove <slug>                       App-Bibliothek: stop an installed program (data is kept)
#
# Every own image must carry a GitHub build-provenance attestation from this repository's deploy
# workflow on main. The app's manifest is read from the image label `app.mininode.manifest`.
# Library programs are third-party images: the entry (image pinned by digest, port, volumes,
# environment) is read from infra/nucbox/library.json on main, never from the caller (ADR 0011).
# A failed health check rolls back to the previous compose file.

set -euo pipefail

OWNER=${MININODE_OWNER:-sulpharus}
REPO=${MININODE_REPO:-Sulpharus/PrivateAppHosting}
DOMAIN=${MININODE_DOMAIN:-mininode.app}
ROOT=${MININODE_ROOT:-/srv/mininode}
SIGNER="$REPO/.github/workflows/deploy.yml"
# GH_TOKEN (read-only: attestations, packages) for `gh attestation verify`; CATALOG_TOKEN
# (Contents: read) for the App-Bibliothek catalog.
# shellcheck source=/dev/null
[ -f /etc/mininode/deploy.env ] && . /etc/mininode/deploy.env
export GH_TOKEN

log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" >&2; }
die() { log "error: $*"; exit 1; }

read -r -a args <<<"${SSH_ORIGINAL_COMMAND:-$*}"
[ "${#args[@]}" -ge 2 ] || die "usage: <slug> <digest> | platform <control|wine> <digest> | library <slug> <entry> | remove <slug>"

digest_ok() { [[ $1 =~ ^sha256:[a-f0-9]{64}$ ]]; }
slug_ok() { [[ $1 =~ ^[a-z][a-z0-9-]{0,30}[a-z0-9]$ && $1 != *--* ]]; }

exec 9>"$ROOT/.deploy.lock"
flock -w 600 9 || die "another deploy is still running"

verify() { # image-ref
  log "verifying provenance of $1"
  gh attestation verify "oci://$1" --repo "$REPO" --signer-workflow "$SIGNER" \
    --source-ref refs/heads/main --bundle-from-oci >/dev/null ||
    die "attestation check failed for $1"
}

probe() { # host port path → 0 when the app answers 2xx/3xx within 60 s
  local url="http://$1:$2$3"
  for _ in $(seq 1 30); do
    if docker exec mininode-traefik-1 wget -q -T 3 -O /dev/null "$url" 2>/dev/null; then return 0; fi
    sleep 2
  done
  return 1
}

# ---------------------------------------------------------------------------------------------
if [ "${args[0]}" = platform ]; then
  component=${args[1]} digest=${args[2]:-}
  digest_ok "$digest" || die "invalid digest"
  case "$component" in
    control)
      image="ghcr.io/$OWNER/mininode-nucbox-control@$digest"
      docker pull -q "$image" >/dev/null
      verify "$image"
      cd "$ROOT/platform"
      cp platform.env platform.env.prev
      sed -i "s|^CONTROL_DIGEST=.*|CONTROL_DIGEST=$digest|" platform.env
      docker compose --env-file platform.env up -d nucbox-control
      if ! probe nucbox-control 8080 /health; then
        mv platform.env.prev platform.env
        docker compose --env-file platform.env up -d nucbox-control
        die "nucbox-control unhealthy, rolled back"
      fi
      ;;
    wine)
      image="ghcr.io/$OWNER/mininode-wine@$digest"
      docker pull -q "$image" >/dev/null
      verify "$image"
      # Running sessions keep their image; new sessions use :current.
      docker tag "$image" "ghcr.io/$OWNER/mininode-wine:current"
      ;;
    *) die "unknown platform component: $component" ;;
  esac
  log "platform $component → $digest"
  exit 0
fi

# Writes $dir/compose.yml. Uses: slug image port memory user read_only env_files volumes.
write_compose() {
  {
    cat <<EOF
# Generated by nucbox-deploy — do not edit.
name: app-$slug
networks:
  mininode:
    external: true
services:
  app:
    image: $image
    container_name: app-$slug
    # Apps never run as root, whatever their Dockerfile says.
    user: "$user"
    restart: unless-stopped
    env_file: [$env_files]
    environment:
      MININODE_APP: $slug
      PORT: "$port"
    networks: [mininode]
    mem_limit: ${memory}m
    memswap_limit: ${memory}m
    pids_limit: 256
    read_only: $read_only
    tmpfs: ["/tmp:size=64m"]
    volumes:
EOF
    for v in "${volumes[@]}"; do printf '      - "%s"\n' "$v"; done
    cat <<EOF
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    logging:
      driver: local
      options: { max-size: "10m", max-file: "3" }
    labels:
      traefik.enable: "true"
      traefik.http.routers.$slug.rule: Host(\`$slug.$DOMAIN\`)
      traefik.http.routers.$slug.entrypoints: web
      traefik.http.routers.$slug.middlewares: mininode-strip@file,mininode-auth@file,mininode-headers@file
      traefik.http.services.$slug.loadbalancer.server.port: "$port"
EOF
  } >"$dir/compose.yml"
}

# Starts $dir/compose.yml; rolls back to compose.prev.yml (or stops) when the app stays unhealthy.
start_or_rollback() { # version
  log "starting $slug"
  docker compose -f "$dir/compose.yml" up -d --remove-orphans
  if probe "app-$slug" "$port" "$health"; then
    echo "$1" >"$dir/deployed"
    rm -f "$dir/compose.prev.yml" "$dir/library.env.prev"
    docker image prune -f --filter "label!=app.mininode.keep" >/dev/null || true
    log "$slug → $1 healthy"
    return 0
  fi
  log "$slug unhealthy, rolling back"
  docker compose -f "$dir/compose.yml" logs --tail 50 app >&2 || true
  [ -f "$dir/library.env.prev" ] && mv "$dir/library.env.prev" "$dir/library.env"
  if [ -f "$dir/compose.prev.yml" ]; then
    mv "$dir/compose.prev.yml" "$dir/compose.yml"
    docker compose -f "$dir/compose.yml" up -d --remove-orphans
  else
    docker compose -f "$dir/compose.yml" down
  fi
  exit 1
}

# ---------------------------------------------------------------------------------------------
if [ "${args[0]}" = remove ]; then
  slug=${args[1]}
  slug_ok "$slug" || die "invalid slug"
  dir="$ROOT/apps/$slug"
  [ -f "$dir/library" ] || die "$slug is not a library app (hosted apps are removed from the repository)"
  if [ -f "$dir/compose.yml" ]; then
    docker compose -f "$dir/compose.yml" down
    mv "$dir/compose.yml" "$dir/compose.removed.yml"
  fi
  rm -f "$dir/deployed"
  log "$slug removed; data kept in $dir/data"
  exit 0
fi

# ---------------------------------------------------------------------------------------------
if [ "${args[0]}" = library ]; then
  slug=${args[1]} entry_id=${args[2]:-}
  slug_ok "$slug" || die "invalid slug"
  slug_ok "$entry_id" || die "invalid library entry"
  dir="$ROOT/apps/$slug"
  if [ -f "$dir/deployed" ] && [ ! -f "$dir/library" ]; then
    die "$slug is a hosted container app"
  fi
  # Another program's data stays its own: switching entries on one address is refused.
  if [ -f "$dir/library" ] && [ "$(cat "$dir/library")" != "$entry_id" ]; then
    die "$slug belongs to library entry $(cat "$dir/library")"
  fi
  # The catalog on main is the only source; the caller only names an entry.
  # CATALOG_TOKEN (deploy.env): fine-grained, this repository only, Contents: read.
  catalog=$(GH_TOKEN=${CATALOG_TOKEN:-$GH_TOKEN} gh api -H "Accept: application/vnd.github.raw+json" \
    "repos/$REPO/contents/infra/nucbox/library.json?ref=main") || die "reading the library catalog failed"
  entry=$(jq -ce --arg id "$entry_id" '.entries[] | select(.id == $id)' <<<"$catalog") ||
    die "unknown library entry: $entry_id"
  image=$(jq -r '.image' <<<"$entry")
  port=$(jq -r '.port' <<<"$entry")
  memory=$(jq -r '.memoryMb' <<<"$entry")
  health=$(jq -r '.healthPath' <<<"$entry")
  user=$(jq -r '.user // "10001:10001"' <<<"$entry")
  read_only=$(jq -r 'if .readOnly == false then "false" else "true" end' <<<"$entry")
  # Same limits as packages/manifest/src/library.ts.
  [[ $image =~ ^[a-z0-9._:/-]+@sha256:[a-f0-9]{64}$ ]] || die "image is not pinned by digest"
  [[ $port =~ ^[0-9]{1,5}$ && $memory =~ ^[0-9]{2,4}$ && $health =~ ^/[A-Za-z0-9/._-]*$ ]] ||
    die "invalid container settings"
  ((memory >= 64 && memory <= 4096)) || die "memory out of range"
  [[ $user =~ ^[1-9][0-9]{2,5}:[1-9][0-9]{2,5}$ ]] || die "invalid user"

  # Containers write into data/: never follow a link they may have planted there (root chown).
  no_link() { [ ! -L "$1" ] || die "refusing symlink $1"; }
  no_link "$dir" && no_link "$dir/data"
  mkdir -p "$dir/data"
  volumes=()
  while IFS=$'\t' read -r name path; do
    [ -n "$name" ] || continue
    [[ $name =~ ^[a-z][a-z0-9-]{0,30}$ && $path =~ ^/[A-Za-z0-9._/-]{1,200}$ && $path != *..* ]] ||
      die "invalid volume $name"
    no_link "$dir/data/$name"
    mkdir -p "$dir/data/$name"
    chown -h "$user" "$dir/data/$name"
    volumes+=("./data/$name:$path")
  done < <(jq -r '(.volumes // {}) | to_entries[] | "\(.key)\t\(.value)"' <<<"$entry")
  if [ "${#volumes[@]}" -eq 0 ]; then
    chown -h "$user" "$dir/data"
    volumes=("./data:/data")
  fi

  log "pulling $image"
  docker pull -q "$image" >/dev/null

  # KEY='value' lines: single quotes stop Compose from expanding ${…} from this root shell's
  # environment (GH_TOKEN). {host}, {slug} and {domain} are filled in; `$` is refused.
  host="$slug.$DOMAIN"
  : >"$dir/library.env.new"
  while IFS=$'\t' read -r key value; do
    [ -n "$key" ] || continue
    [[ $key =~ ^[A-Za-z_][A-Za-z0-9_]{0,63}$ ]] || die "invalid environment name $key"
    value=${value//\{host\}/$host}
    value=${value//\{slug\}/$slug}
    value=${value//\{domain\}/$DOMAIN}
    [[ $value != *[\$\'\\]* ]] || die "environment value of $key contains \$, ' or \\"
    printf "%s='%s'\n" "$key" "$value" >>"$dir/library.env.new"
  done < <(jq -r '(.env // {}) | to_entries[] | "\(.key)\t\(.value | gsub("[\n\r\t]"; " "))"' <<<"$entry")
  [ -f "$dir/library.env" ] && cp "$dir/library.env" "$dir/library.env.prev"
  mv "$dir/library.env.new" "$dir/library.env"
  env_files="library.env"

  [ -f "$dir/compose.yml" ] && cp "$dir/compose.yml" "$dir/compose.prev.yml"
  write_compose
  start_or_rollback "$entry_id ${image##*@}"
  echo "$entry_id" >"$dir/library"
  exit 0
fi

# ---------------------------------------------------------------------------------------------
slug=${args[0]} digest=${args[1]}
slug_ok "$slug" || die "invalid slug"
digest_ok "$digest" || die "invalid digest"

dir="$ROOT/apps/$slug"
[ -f "$dir/library" ] && die "$slug is a library app"
image="ghcr.io/$OWNER/mininode-$slug@$digest"
log "pulling $image"
docker pull -q "$image" >/dev/null
verify "$image"

manifest=$(docker image inspect --format '{{ index .Config.Labels "app.mininode.manifest" }}' "$image")
[ -n "$manifest" ] && [ "$manifest" != "<no value>" ] || die "image has no app.mininode.manifest label"
[ "$(jq -r '.slug' <<<"$manifest")" = "$slug" ] || die "manifest slug does not match"
[ "$(jq -r '.target' <<<"$manifest")" = nucbox ] || die "manifest target is not nucbox"
port=$(jq -r '.container.port' <<<"$manifest")
memory=$(jq -r '.container.memoryMb // 256' <<<"$manifest")
health=$(jq -r '.container.healthPath // "/health"' <<<"$manifest")
[[ $port =~ ^[0-9]+$ && $memory =~ ^[0-9]+$ && $health =~ ^/[A-Za-z0-9/._-]*$ ]] || die "invalid container settings"

mkdir -p "$dir/data"
# Platform-provided settings; app-specific secrets can be appended by the admin (SOPS-managed).
[ -f "$dir/app.env" ] || cp "$ROOT/platform/apps.env" "$dir/app.env"
[ -f "$dir/compose.yml" ] && cp "$dir/compose.yml" "$dir/compose.prev.yml"
user="10001:10001" read_only=true env_files="app.env" volumes=("./data:/data")
write_compose
chown -R 10001:10001 "$dir/data"
start_or_rollback "$digest"
