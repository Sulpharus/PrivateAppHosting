#!/usr/bin/env bash
# Forced command of the `deploy` SSH user; runs as root through a single sudoers rule:
#   authorized_keys: restrict,command="sudo -n /usr/local/bin/nucbox-deploy \"$SSH_ORIGINAL_COMMAND\"" ssh-ed25519 …
#   sudoers:         deploy ALL=(root) NOPASSWD: /usr/local/bin/nucbox-deploy
# CI can only ask for exactly these rollouts, nothing else:
#
#   <slug> sha256:<digest>              container app ghcr.io/<owner>/mininode-<slug>@<digest>
#   platform control sha256:<digest>    nucbox-control
#   platform wine sha256:<digest>       Wine runtime image (tagged :current for new sessions)
#
# Every image must carry a GitHub build-provenance attestation from this repository's deploy
# workflow on main. The app's manifest is read from the image label `app.mininode.manifest`.
# A failed health check rolls back to the previous compose file.

set -euo pipefail

OWNER=${MININODE_OWNER:-sulpharus}
REPO=${MININODE_REPO:-Sulpharus/PrivateAppHosting}
DOMAIN=${MININODE_DOMAIN:-mininode.app}
ROOT=${MININODE_ROOT:-/srv/mininode}
SIGNER="$REPO/.github/workflows/deploy.yml"
# GH_TOKEN (read-only: attestations, packages) for `gh attestation verify`.
# shellcheck source=/dev/null
[ -f /etc/mininode/deploy.env ] && . /etc/mininode/deploy.env
export GH_TOKEN

log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" >&2; }
die() { log "error: $*"; exit 1; }

read -r -a args <<<"${SSH_ORIGINAL_COMMAND:-$*}"
[ "${#args[@]}" -ge 2 ] || die "usage: <slug> <digest> | platform <control|wine> <digest>"

digest_ok() { [[ $1 =~ ^sha256:[a-f0-9]{64}$ ]]; }

exec 9>"$ROOT/.deploy.lock"
flock -w 600 9 || die "another deploy is still running"

verify() { # image-ref
  log "verifying provenance of $1"
  gh attestation verify "oci://$1" --repo "$REPO" --signer-workflow "$SIGNER" \
    --source-ref refs/heads/main --bundle-from-oci >/dev/null ||
    die "attestation check failed for $1"
}

probe() { # host port path → 0 when the app answers 2xx/3xx within 60 s
  local url="http://$1:$2$3"
  for _ in $(seq 1 30); do
    if docker exec mininode-traefik-1 wget -q -T 3 -O /dev/null "$url" 2>/dev/null; then return 0; fi
    sleep 2
  done
  return 1
}

# ---------------------------------------------------------------------------------------------
if [ "${args[0]}" = platform ]; then
  component=${args[1]} digest=${args[2]:-}
  digest_ok "$digest" || die "invalid digest"
  case "$component" in
    control)
      image="ghcr.io/$OWNER/mininode-nucbox-control@$digest"
      docker pull -q "$image" >/dev/null
      verify "$image"
      cd "$ROOT/platform"
      cp platform.env platform.env.prev
      sed -i "s|^CONTROL_DIGEST=.*|CONTROL_DIGEST=$digest|" platform.env
      docker compose --env-file platform.env up -d nucbox-control
      if ! probe nucbox-control 8080 /health; then
        mv platform.env.prev platform.env
        docker compose --env-file platform.env up -d nucbox-control
        die "nucbox-control unhealthy, rolled back"
      fi
      ;;
    wine)
      image="ghcr.io/$OWNER/mininode-wine@$digest"
      docker pull -q "$image" >/dev/null
      verify "$image"
      # Running sessions keep their image; new sessions use :current.
      docker tag "$image" "ghcr.io/$OWNER/mininode-wine:current"
      ;;
    *) die "unknown platform component: $component" ;;
  esac
  log "platform $component → $digest"
  exit 0
fi

# ---------------------------------------------------------------------------------------------
slug=${args[0]} digest=${args[1]}
[[ $slug =~ ^[a-z][a-z0-9-]{0,30}[a-z0-9]$ ]] || die "invalid slug"
digest_ok "$digest" || die "invalid digest"

image="ghcr.io/$OWNER/mininode-$slug@$digest"
log "pulling $image"
docker pull -q "$image" >/dev/null
verify "$image"

manifest=$(docker image inspect --format '{{ index .Config.Labels "app.mininode.manifest" }}' "$image")
[ -n "$manifest" ] && [ "$manifest" != "<no value>" ] || die "image has no app.mininode.manifest label"
[ "$(jq -r '.slug' <<<"$manifest")" = "$slug" ] || die "manifest slug does not match"
[ "$(jq -r '.target' <<<"$manifest")" = nucbox ] || die "manifest target is not nucbox"
port=$(jq -r '.container.port' <<<"$manifest")
memory=$(jq -r '.container.memoryMb // 256' <<<"$manifest")
health=$(jq -r '.container.healthPath // "/health"' <<<"$manifest")
[[ $port =~ ^[0-9]+$ && $memory =~ ^[0-9]+$ && $health =~ ^/[A-Za-z0-9/._-]*$ ]] || die "invalid container settings"

dir="$ROOT/apps/$slug"
mkdir -p "$dir/data"
# Platform-provided settings; app-specific secrets can be appended by the admin (SOPS-managed).
[ -f "$dir/app.env" ] || cp "$ROOT/platform/apps.env" "$dir/app.env"
[ -f "$dir/compose.yml" ] && cp "$dir/compose.yml" "$dir/compose.prev.yml"

cat >"$dir/compose.yml" <<EOF
# Generated by nucbox-deploy — do not edit.
name: app-$slug
networks:
  mininode:
    external: true
services:
  app:
    image: $image
    container_name: app-$slug
    # Apps never run as root, whatever their Dockerfile says.
    user: "10001:10001"
    restart: unless-stopped
    env_file: [app.env]
    environment:
      MININODE_APP: $slug
      PORT: "$port"
    networks: [mininode]
    mem_limit: ${memory}m
    memswap_limit: ${memory}m
    pids_limit: 256
    read_only: true
    tmpfs: ["/tmp:size=64m"]
    volumes: ["./data:/data"]
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    logging:
      driver: local
      options: { max-size: "10m", max-file: "3" }
    labels:
      traefik.enable: "true"
      traefik.http.routers.$slug.rule: Host(\`$slug.$DOMAIN\`)
      traefik.http.routers.$slug.entrypoints: web
      traefik.http.routers.$slug.middlewares: mininode-strip@file,mininode-auth@file,mininode-headers@file
      traefik.http.services.$slug.loadbalancer.server.port: "$port"
EOF
chown -R 10001:10001 "$dir/data"

log "starting $slug"
docker compose -f "$dir/compose.yml" up -d --remove-orphans
if probe "app-$slug" "$port" "$health"; then
  echo "$digest" >"$dir/deployed"
  rm -f "$dir/compose.prev.yml"
  docker image prune -f --filter "label!=app.mininode.keep" >/dev/null || true
  log "$slug → $digest healthy"
else
  log "$slug unhealthy, rolling back"
  docker compose -f "$dir/compose.yml" logs --tail 50 app >&2 || true
  if [ -f "$dir/compose.prev.yml" ]; then
    mv "$dir/compose.prev.yml" "$dir/compose.yml"
    docker compose -f "$dir/compose.yml" up -d --remove-orphans
  else
    docker compose -f "$dir/compose.yml" down
  fi
  exit 1
fi
