# nucbox-control credentials. The real file is secrets.sops.env (encrypted with age via SOPS,
# see ../../.sops.yaml) and decrypted to secrets.env on the VM: `sops -d secrets.sops.env > secrets.env`.
# Never commit secrets.env.

CONTROL_TOKEN=                  # openssl rand -hex 32 — same value as the API Worker secret NUCBOX_CONTROL_TOKEN
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
PORTAL_URL=https://mininode.app
PLATFORM_DOMAIN=mininode.app

PROXMOX_URL=https://10.10.0.1:8006
PROXMOX_NODE=nucbox
PROXMOX_TOKEN=mininode@pve!control=<uuid>   # role MininodeControl, see nucbox-install.md
WINDOWS_VMID=200
WINDOWS_HOST=10.10.0.20
WINDOWS_RDP_USER=mininode
WINDOWS_RDP_PASSWORD=
WINDOWS_IDLE_MINUTES=15

WINE_ENABLED=true
WINE_IMAGE=ghcr.io/sulpharus/mininode-wine:current
WINE_IDLE_MINUTES=10

# R2 API token with Object Read on mininode-installers only (presigned downloads).
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mininode-installers
