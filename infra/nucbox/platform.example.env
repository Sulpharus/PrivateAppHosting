# /srv/mininode/platform/platform.env — non-secret compose variables; CONTROL_DIGEST is
# maintained by nucbox-deploy.
TUNNEL_TOKEN=                    # cloudflare-secrets/TUNNEL_TOKEN from infra/cloudflare/bootstrap.sh
GUACAMOLE_JSON_SECRET=           # openssl rand -hex 16 — same as the API Worker secret
DOCKER_GID=                      # getent group docker | cut -d: -f3
CONTROL_DIGEST=sha256:<digest>
