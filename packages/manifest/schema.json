{
  "title": "MiniNode app manifest (mininode.json)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "specVersion": {
      "type": "number",
      "const": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,30}[a-z0-9]$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "kind": {
      "type": "string",
      "enum": [
        "static",
        "spa",
        "nextjs",
        "container",
        "remote"
      ]
    },
    "target": {
      "type": "string",
      "enum": [
        "cloudflare",
        "vercel",
        "nucbox",
        "remote"
      ]
    },
    "access": {
      "default": {
        "default": false,
        "roles": [
          "user",
          "trusted",
          "admin"
        ]
      },
      "type": "object",
      "properties": {
        "default": {
          "default": false,
          "type": "boolean"
        },
        "roles": {
          "default": [
            "user",
            "trusted",
            "admin"
          ],
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "admin",
              "trusted",
              "user"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "data": {
      "default": {
        "mode": "none"
      },
      "type": "object",
      "properties": {
        "mode": {
          "default": "none",
          "type": "string",
          "enum": [
            "none",
            "private",
            "shared-account",
            "group",
            "readonly"
          ]
        }
      },
      "additionalProperties": false
    },
    "ai": {
      "type": "object",
      "properties": {
        "models": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "gemini-flash",
              "gemini-pro",
              "claude-haiku",
              "claude-sonnet"
            ]
          }
        },
        "monthlyBudgetEur": {
          "default": 2,
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "maxOutputTokens": {
          "default": 2000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 16000
        }
      },
      "required": [
        "models"
      ],
      "additionalProperties": false
    },
    "google": {
      "type": "object",
      "properties": {
        "gmail": {
          "type": "string",
          "enum": [
            "read",
            "write"
          ]
        },
        "calendar": {
          "type": "string",
          "enum": [
            "read",
            "write"
          ]
        }
      },
      "additionalProperties": false
    },
    "apis": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,40}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "baseUrl": {
            "type": "string"
          },
          "auth": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "header"
                  },
                  "name": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9-]{0,40}$"
                  },
                  "prefix": {
                    "type": "string",
                    "pattern": "^[ -~]{0,20}$"
                  }
                },
                "required": [
                  "type",
                  "name"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "bearer"
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "none"
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "query"
                  },
                  "param": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,40}$"
                  }
                },
                "required": [
                  "type",
                  "param"
                ],
                "additionalProperties": false
              }
            ]
          },
          "docs": {
            "type": "string",
            "format": "uri"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "id",
          "name",
          "baseUrl",
          "auth",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "game": {
      "type": "object",
      "properties": {
        "genre": {
          "type": "string",
          "enum": [
            "puzzle",
            "arcade",
            "karten",
            "brett",
            "quiz",
            "wort",
            "strategie",
            "sonstiges"
          ]
        },
        "players": {
          "default": "solo",
          "type": "string",
          "enum": [
            "solo",
            "multi",
            "both"
          ]
        },
        "stats": {
          "default": [],
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,30}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 30
              },
              "better": {
                "default": "higher",
                "type": "string",
                "enum": [
                  "higher",
                  "lower"
                ]
              },
              "format": {
                "default": "number",
                "type": "string",
                "enum": [
                  "number",
                  "seconds"
                ]
              },
              "min": {
                "default": 0,
                "type": "number"
              },
              "max": {
                "type": "number"
              }
            },
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "genre"
      ],
      "additionalProperties": false
    },
    "suite": {
      "type": "object",
      "properties": {
        "uses": {
          "minItems": 1,
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "event",
                  "task",
                  "reminder",
                  "project",
                  "activity",
                  "contract",
                  "transaction"
                ]
              },
              "access": {
                "type": "string",
                "enum": [
                  "read",
                  "create",
                  "write",
                  "delete"
                ]
              },
              "why": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "type",
              "access",
              "why"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "uses"
      ],
      "additionalProperties": false
    },
    "build": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "output": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "output"
      ],
      "additionalProperties": false
    },
    "container": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "memoryMb": {
          "default": 256,
          "type": "integer",
          "minimum": 64,
          "maximum": 4096
        },
        "healthPath": {
          "default": "/health",
          "type": "string",
          "format": "starts_with",
          "pattern": "^\\/.*"
        }
      },
      "required": [
        "port"
      ],
      "additionalProperties": false
    },
    "remote": {
      "type": "object",
      "properties": {
        "runtime": {
          "type": "string",
          "enum": [
            "windows",
            "wine",
            "android"
          ]
        },
        "program": {
          "type": "string",
          "minLength": 1
        },
        "installer": {
          "type": "object",
          "properties": {
            "r2Key": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "silentArgs": {
              "type": "string",
              "maxLength": 200
            }
          },
          "required": [
            "r2Key",
            "sha256"
          ],
          "additionalProperties": false
        },
        "wingetId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "runtime",
        "program"
      ],
      "additionalProperties": false
    },
    "library": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,30}[a-z0-9]$"
    }
  },
  "required": [
    "specVersion",
    "slug",
    "name",
    "description",
    "kind",
    "target"
  ],
  "additionalProperties": false
}
